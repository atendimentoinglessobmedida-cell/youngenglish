    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 8,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "We also need a rule about taking photos of other people.",
