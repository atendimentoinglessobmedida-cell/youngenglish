    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 4,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "Yes. We could keep notifications silent during that activity.",
