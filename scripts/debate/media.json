    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 13,
    "speaker": "Leo",
    "voice": "am_michael",
    "text": "That sounds fair, with a private process for exceptions and a review after two weeks.",
    "bytes": 44396,
    "sha256": "343b86822d0baf1a44d1b04aaea2b25640caa03ce9c56def18147427d4d4b204",
    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "word",
    "turn": 0,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "distraction. Notifications can be a distraction during reading.",
