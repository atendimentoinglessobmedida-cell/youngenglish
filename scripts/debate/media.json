    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 6,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "There should be an exception agreed privately with the teacher.",
