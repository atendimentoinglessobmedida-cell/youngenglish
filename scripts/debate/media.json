    "sha256": "59af782c144c2e23f4628b727e3754a84f3b5068f7918877ba8471e3d8e31a56",
    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 10,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "How can we check whether our agreement helps students concentrate?",
