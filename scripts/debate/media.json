    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 12,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "So our rules are to put phones away, use them for agreed tasks and respect privacy.",
