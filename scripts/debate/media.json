    "sha256": "cdcaef2e3c73ac8f51f1355647997f50bccd7a7add802ddfa846fa31b5a4f6cd",
    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "word",
    "turn": 5,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "reach an agreement. Let us reach an agreement before the trial starts.",
