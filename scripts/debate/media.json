  },
  {
    "app": "young",
    "unitId": "ai-homework",
    "kind": "turn",
    "turn": 1,
    "speaker": "Leo",
    "voice": "am_michael",
    "text": "I would allow explanations, but copying a finished answer seems like a shortcut.",
