  },
  {
    "app": "young",
    "unitId": "ai-homework",
    "kind": "turn",
    "turn": 13,
    "speaker": "Leo",
    "voice": "am_michael",
    "text": "Agreed. And no one should upload private information about themselves or classmates.",
