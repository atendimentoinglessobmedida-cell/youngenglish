    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 1,
    "speaker": "Leo",
    "voice": "am_michael",
    "text": "I think we should put them away because messages can be a distraction.",
    "bytes": 36716,
    "sha256": "47363226123c2580bfad55de9a121ac508e890738c2c7a3c843958f93365c29c",
    "humanReviewed": false
  },
  {
    "app": "young",
    "unitId": "school-phones",
    "kind": "turn",
    "turn": 2,
    "speaker": "Maya",
    "voice": "af_heart",
    "text": "That could help, but I sometimes use a dictionary app.",
